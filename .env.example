APP_NAME=UPanel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Domain - Used by Caddy for SSL (use localhost for local dev)
DOMAIN_NAME=localhost

# =============================================================================
# REVERSE PROXY SETTINGS (Nginx Proxy Manager, Traefik, etc.)
# =============================================================================
# Use these settings when running UPanel behind a reverse proxy.
# See docs/DEPLOYMENT.md for detailed setup instructions.

# Port to expose when running behind reverse proxy (docker-compose.proxy.yml)
PROXY_PORT=8080

# Trusted proxy IPs - Required when behind a reverse proxy
# Options:
#   - Not set: No proxy trust (direct access)
#   - "*": Trust all proxies (safe in Docker isolated networks)
#   - Specific IPs: "172.17.0.1,10.0.0.0/8" (recommended for production)
# TRUSTED_PROXIES=*

# Session secure cookie - Set to false when testing over HTTP (no SSL)
# IMPORTANT: Set to true in production with HTTPS!
SESSION_SECURE_COOKIE=false

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Database - CHANGE THESE IN PRODUCTION
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=upanel
DB_USERNAME=upanel
DB_PASSWORD=  # Required - generate with: openssl rand -base64 32

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=480

# Redis - CHANGE IN PRODUCTION
REDIS_HOST=redis
REDIS_PASSWORD=  # Required - generate with: openssl rand -base64 32
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="upanel@example.com"
MAIL_FROM_NAME="${APP_NAME}"
